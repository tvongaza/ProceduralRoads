<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ToolkitGameSessionsVersion Condition="'$(ToolkitGameSessionsVersion)' == ''">0.1.0-preview.17</ToolkitGameSessionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Valheim.Testing.GameSessions" Version="[$(ToolkitGameSessionsVersion)]" />
  </ItemGroup>
</Project>
