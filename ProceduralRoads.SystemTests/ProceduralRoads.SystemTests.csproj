<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ToolkitGameVersion Condition="'$(ToolkitGameVersion)' == ''">0.1.0-preview.57</ToolkitGameVersion>
    <ToolkitGameSessionsVersion Condition="'$(ToolkitGameSessionsVersion)' == ''">0.1.0-preview.17</ToolkitGameSessionsVersion>
  </PropertyGroup>
  <PropertyGroup><OutputType>Exe</OutputType><RollForward>Major</RollForward><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Valheim.Testing.Game" Version="[$(ToolkitGameVersion)]" />
    <PackageReference Include="Valheim.Testing.GameSessions" Version="[$(ToolkitGameSessionsVersion)]" />
  </ItemGroup>
  <ItemGroup><Compile Include="../ProceduralRoads.TestFixtures/FlatRoadFixture.cs" Link="Fixtures/FlatRoadFixture.cs" /></ItemGroup>
</Project>
